{
  "name": "tasklog",
  "displayName": "Task Log",
  "description": "%extension.description%",
  "version": "0.1.0",
  "publisher": "local",
  "private": true,
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "contributes": {
    "commands": [
      {
        "command": "taskLog.createTaskFromSelection",
        "title": "%taskLog.createTaskFromSelection.title%"
      },
      {
        "command": "taskLog.setParent",
        "title": "%taskLog.setParent.title%"
      },
      {
        "command": "taskLog.setFocus",
        "title": "%taskLog.setFocus.title%"
      },
      {
        "command": "taskLog.clearFocus",
        "title": "%taskLog.clearFocus.title%"
      },
      {
        "command": "taskLog.markDone",
        "title": "%taskLog.markDone.title%",
        "icon": "$(circle-outline)"
      },
      {
        "command": "taskLog.markOpen",
        "title": "%taskLog.markOpen.title%",
        "icon": "$(pass)"
      },
      {
        "command": "taskLog.deleteTask",
        "title": "%taskLog.deleteTask.title%"
      },
      {
        "command": "taskLog.reanchorTask",
        "title": "%taskLog.reanchorTask.title%"
      },
      {
        "command": "taskLog.revealTaskInEditor",
        "title": "%taskLog.revealTaskInEditor.title%"
      },
      {
        "command": "taskLog.toggleStatusAtCursor",
        "title": "%taskLog.toggleStatusAtCursor.title%"
      },
      {
        "command": "taskLog.setJiraApiToken",
        "title": "%taskLog.setJiraApiToken.title%"
      },
      {
        "command": "taskLog.linkJiraIssue",
        "title": "%taskLog.linkJiraIssue.title%"
      },
      {
        "command": "taskLog.pushSummaryToJira",
        "title": "%taskLog.pushSummaryToJira.title%"
      }
    ],
    "configuration": {
      "title": "Task Log",
      "properties": {
        "taskLog.jira.baseUrl": {
          "type": "string",
          "default": "",
          "description": "%taskLog.jira.baseUrl.description%"
        },
        "taskLog.jira.email": {
          "type": "string",
          "default": "",
          "description": "%taskLog.jira.email.description%"
        }
      }
    },
    "views": {
      "explorer": [
        {
          "id": "taskLog.tree",
          "name": "%taskLog.tree.name%"
        }
      ]
    },
    "menus": {
      "view/item/context": [
        {
          "command": "taskLog.markDone",
          "when": "view == taskLog.tree && viewItem == taskLog.task.open",
          "group": "inline"
        },
        {
          "command": "taskLog.markOpen",
          "when": "view == taskLog.tree && viewItem == taskLog.task.done",
          "group": "inline"
        }
      ]
    }
  },
  "scripts": {
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package": "node esbuild.js --production",
    "vscode:prepublish": "npm run package",
    "test:unit": "vitest run",
    "test:integration": "node ./out/test/integration/runTest.js",
    "pretest:integration": "tsc -p . --outDir out",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "l10n:export": "npx @vscode/l10n-dev export --outDir ./l10n ./src"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/l10n-dev": "^0.0.35",
    "@vscode/test-electron": "^2.3.9",
    "esbuild": "^0.20.2",
    "eslint": "^9.1.0",
    "glob": "^10.3.12",
    "mocha": "^10.4.0",
    "prettier": "^3.2.5",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.0.0",
    "vitest": "^1.5.0"
  }
}
